VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
VITE_DEFAULT_STORE_SLUG=sample
VITE_APP_ENV=production

# Telemetria comercial sem PII. Ative somente depois de aplicar a migration RC2.
VITE_ANALYTICS_ENABLED=true

# Chave publica do Cloudflare Turnstile. Nunca coloque o secret no Vite/browser.
VITE_TURNSTILE_SITE_KEY=
